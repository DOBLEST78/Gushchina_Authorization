<Page x:Class="Gushchina_Authorization.Pages.Client"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница клиента"
      Background="#F2F7F7">

    <Grid>

        <Border Width="420"
                Padding="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="18">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="3"
                                  Opacity="0.20"
                                  Color="#263238"/>
            </Border.Effect>

            <StackPanel>

                <Image Width="120"
                       Height="120"
                       Margin="0,0,0,15"
                       Source="/Gushchina_Authorization;component/Resources/logo.png"
                       Stretch="Uniform"/>

                <TextBlock Text="Добро пожаловать!"
                           HorizontalAlignment="Center"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#087F73"/>

                <TextBlock Text="Вы вошли в приложение как гость"
                           Margin="5,10,5,5"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           TextAlignment="Center"/>

                <TextBlock Text="Это страница клиента"
                           HorizontalAlignment="Center"
                           Foreground="#607D8B"/>

            </StackPanel>
        </Border>
    </Grid>

</Page>