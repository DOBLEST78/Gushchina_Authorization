<Page x:Class="Gushchina_Authorization.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация"
      Background="#F2F7F7">

    <Grid>

        <!-- Белая карточка авторизации -->
        <Border Width="420"
                Padding="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="18">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="3"
                                  Opacity="0.20"
                                  Color="#263238"/>
            </Border.Effect>

            <StackPanel>

                <Image Width="100"
                       Height="100"
                       Margin="0,0,0,10"
                       Source="/Gushchina_Authorization;component/Resources/logo.png"
                       Stretch="Uniform"/>

                <TextBlock Text="Вход в систему"
                           Margin="5,0,5,20"
                           HorizontalAlignment="Center"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#087F73"/>

                <TextBlock Text="Логин"/>

                <TextBox x:Name="TxtLogin"/>

                <TextBlock Text="Пароль"
                           Margin="5,12,5,5"/>

                <PasswordBox x:Name="PswPassword"/>

                <StackPanel Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">

                    <Button x:Name="BtnEnterGuests"
                            Width="165"
                            Content="Войти как гость"
                            Click="BtnEnterGuests_Click"/>

                    <Button x:Name="BtnEnter"
                            Width="120"
                            Content="Войти"
                            Click="BtnEnter_Click"/>

                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>

</Page>